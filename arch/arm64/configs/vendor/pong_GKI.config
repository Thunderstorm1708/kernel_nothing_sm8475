# Nothing Phone (2) on top of gki_defconfig and waipio_GKI.config.
#
# Kleaf builds the GKI kernel_aarch64 target with these settings, which a
# make build has to restate: the KMI symbol list trims the exported symbols
# and GKI only lets protected modules load when they are signed.
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_COMPRESSED_ZSTD is not set
CONFIG_MODULE_SIG_PROTECT=y
CONFIG_MODULE_SIG_PROTECT_LIST="android/protected_module_names_list"
CONFIG_TRIM_UNUSED_KSYMS=y
CONFIG_UNUSED_KSYMS_WHITELIST="android/abi_symbollist.raw"
